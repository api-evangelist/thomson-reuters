{"openapi":"3.0.1","info":{"title":"ONESOURCE E-Invoicing Company API","description":"The Company API allows you to retrieve information about companies, including their addresses, contact information, and identifiers. You can fetch all companies accessible to the calling user, sorted alphabetically by company name.","version":"0.7.0"},"servers":[{"url":"https://api-uat.onesourcetax.com/einvoicing/document/v1"},{"url":"https://api-emea.onesourcetax.com/einvoicing/document/v1"}],"tags":[{"name":"Company","description":"Get Companies."}],"paths":{"/companies":{"get":{"tags":["Company"],"summary":"Get companies.","description":"Get all companies the calling user has access to. The companies are sorted in alphabetic order by company name.","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Company"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"500":{"$ref":"#/components/responses/InternalServerError","description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/InternalServerErrorCompany"}}}}}}}}},"components":{"schemas":{"Company":{"type":"object","properties":{"id":{"type":"string","description":"unique ID generated by OEI for each company"},"name":{"type":"string","description":"The company name"},"department":{"type":"string","description":"The department"},"address":{"$ref":"#/components/schemas/CompanyAddress"},"identifiers":{"type":"array","items":{"$ref":"#/components/schemas/CompanyId"}},"contact":{"$ref":"#/components/schemas/ContactInformation"},"customerNumber":{"type":"string"}}},"CompanyId":{"type":"object","properties":{"idType":{"type":"string","description":"Type of id"},"value":{"type":"string","description":"The id value"}}},"ContactInformation":{"type":"object","properties":{"email":{"type":"string","description":"The company's email address"},"phone":{"type