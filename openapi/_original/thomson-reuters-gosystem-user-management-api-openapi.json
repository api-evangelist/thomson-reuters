e,"EditTimeLog":true,"Password":"Password1$","GrantUserRights":[]}]},"Disable time tracking":{"value":[{"Fullname":"Rajat JoshiTest","Email":"test@test.com","ID":{"Firm":"FT","Location":"FTSUPPORT","LoginId":"RAJAT-TEST"},"GroupIds":[16],"EnableTT":false,"Password":"Password1$","GrantUserRights":[]}]},"Change location of non triple star user using triple star user":{"value":[{"Fullname":"Rajat JoshiTest","Email":"test@test.com","ID":{"Firm":"FT","Location":"FTSUPPORT","LoginId":"RAJAT-TEST"},"GroupIds":[16],"NewLocation":"FT"}]},"Change location of triple star user logged in as other location triple star":{"value":[{"Fullname":"Rajat JoshiTest","Email":"test@test.com","ID":{"Firm":"2WF5","Location":"***","LoginId":"NEWTEST"},"GroupIds":[16],"NewLocation":"FT"}]}}}},"required":true},"responses":{"200":{"description":"Success. The user is updated.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserUpdationResponseList"},"examples":{"Success response":{"value":[{"UserDetails":{"Location":"FTSUPPORT","LoginId":"TestUser001"},"Message":"User Updated Successfully","Status":0}]},"Update user login ID success response":{"value":[{"UserDetails":{"Location":"FTSUPPORT","LoginId":"RAJAT-TEST1"},"Message":"User Updated Successfully","Status":0}]},"Error response":{"value":[{"UserDetails":{"Location":"FTSUPPORT","LoginId":"TestUser001"},"Message":"You can not grant or revoke EFORMRS, because you don't own it; You can not grant or revoke EFORMRS, because you don't own it","Status":1}]},"Change location of triple star logged in as other location triple star error response":{"value":[{"UserDetails":{"Location":"***","LoginId":"NEWTEST"},"Message":"user(NEWTEST) is either deleted or does not exist","Status":1}]}}}}},"403":{"description":"Edit user permission required."},"404":{"description":"Not found"}}},"delete":{"tags":["User Management"],"summary":"Delete user","operationId":"Trigger Delete User","description":"This endpoint deletes a user from the GoSystem User Management system.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteUserRequestWrapper"},"examples":{"Delete user request":{"value":[{"Location":"FTSUPPORT","LoginId":"TestUser001"}]}}}},"required":true},"responses":{"200":{"description":"Success. The user is deleted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserUpdationResponseList"},"examples":{"Success response":{"value":[{"UserDetails":{"Location":"FTSUPPORT","LoginId":"TestUser001"},"Message":"User Deleted Successfully","Status":0}]},"Error response":{"value":[{"UserDetails":{"Location":"FTSUPPORT","LoginId":"TestUser001"},"Message":"user(testuser001) is either deleted or does not exist","Status":1}]}}}}},"403":{"description":"Add user permission required."},"404":{"description":"Not found"}}},"get":{"tags":["User Management"],"summary":"Get active or inactive users list","operationId":"Get users list","description":"This endpoint retrieves a list of active or inactive users for a specified location.","parameters":[{"name":"location","in":"query","description":"Current location name of the firm.","required":true,"schema":{"type":"string"}},{"name":"getActive","in":"query","description":"Flag for getting active users.","required":true,"schema":{"type":"boolean"}},{"name":"getInactive","in":"query","description":"Flag for getting inactive users.","required":true,"schema":{"type":"boolean"}}],"responses":{"200":{"description":"Success. The users list is retrieved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetUserResponseWrapper"},"examples":{"Success response":{"value":[{"Deleted":true,"ID":{"Location":"FTSUPPORT","LoginId":"TestUser001"},"Email":"test.user@test.com","EmployeeID":"12345","Fullname":"Test User","IsAdministrator":true,"GrantUserRights":["FORMSOURCE","EFORMRS","TAXINFOADMIN","TEQ","RMVCMPDATE"],"GrantAdminRights":["CREATEADMIN","GROUPIMPORT","FREERETURNS","TRANSFER"],"GroupIds":[11,17]},{"Deleted":false,"ID":{"Location":"FTSUPPORT","LoginId":"TestUser002"},"Email":"test.user2@test.com","EmployeeID":"12345","Fullname":"Test User2","IsAdministrator":false,"GrantUserRights":["FORMSOURCE"],"GrantAdminRights":[],"GroupIds":[11]}]}}}}},"404":{"description":"Not found"}}}},"/v1/users/myprofile":{"get":{"tags":["User Management"],"summary":"Get current user and permissions details","operationId":"Get current user details","description":"This endpoint retrieves the current user's profile and permissions details.","responses":{"200":{"description":"Success. The user profile and permissions details are retrieved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetUserResponse"},"examples":{"Success response":{"value":{"Deleted":false,"ID":{"Location":"FTSUPPORT","LoginId":"TestUser001"},"Email":"test.user@test.com","EmployeeID":"12345","Fullname":"Test User","IsAdministrator":true,"GrantUserRights":["FORMSOURCE","EFORMRS","TAXINFOADMIN","TEQ","RMVCMPDATE"],"GrantAdminRights":["CREATEADMIN","GROUPIMPORT","FREERETURNS","TRANSFER"],"GroupIds":[11,17]}}}}}},"404":{"description":"Not found"}}}},"/v1/users/allpermissions":{"get":{"tags":["User Management"],"summary":"Get all user and admin related permissions","operationId":"Get permission details","description":"This endpoint retrieves all user and admin related permissions available in the system.","responses":{"200":{"description":"Success. All user and admin permissions are retrieved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PermissionResponse"},"examples":{"Success response":{"value":{"AdminRights":[{"Right":"Add Groups","Code":"ADDGROUPS","Description":"Allows users to add new groups"},{"Right":"Edit Groups","Code":"EDITGROUPS","Description":"Allows users to edit existing groups"},{"Right":"Delete Groups","Code":"DELETEGROUPS","Description":"Allows users to delete existing groups"},{"Right":"Firm Config","Code":"FIRMCONFIG","Description":"User will have access to firm config and also make changes to it"},{"Right":"Letters and Filing Instr","Code":"LAFI","Description":"User can fully access Letters and Filling instructions"},{"Right":"Add Users","Code":"ADDUSER","Description":"Allows users to add new users"},{"Right":"Edit Users","Code":"EDITUSER","Description":"Allows users to edit existing users"},{"Right":"Delete Users","Code":"DELETEUSER","Description":"Allows users to delete existing users"},{"Right":"Transfer","Code":"TRANSFER","Description":"User will have access to transfer returns from one account to another within same firm"},{"Right":"External Transfer","Code":"ETXR","Description":"User will have access to transfer returns from account to another outside own firm too"},{"Right":"Create Administrator","Code":"CREATEADMIN","Description":"Allows users to create new administrator users with admin rights"},{"Right":"Group Import","Code":"GROUPIMPORT","Description":"Allow users to do group import"},{"Right":"Free Other Returns","Code":"FREERETURNS","Description":"Allows user to  free returns"},{"Right":"De-Federate User","Code":"DEFEDERATE","Description":"Allow user to de federate a federated user"}],"UserRights":[{"Right":"FormSource","Code":"FORMSOURCE","Description":"Gives user access to use formsource and run queries."},{"Right":"e-Form RS","Code":"EFORMRS","Description":"Gives user permission to access E-form RS application in Gosystem RS"},{"Right":"Export Grid Data","Code":"EXPORTGRIDDATA","Description":"Allows user access to export grid data"},{"Right":"MyTaxInfo Admin","Code":"TAXINFOADMIN","Description":"Gives user administrator access to MyTaxInfo, allowing them to have full access to customize theme, contact email and legal information. Review/Edit a tax payer questionnaire etc"},{"Right":"MyTaxInfo Preparer (Full Access)","Code":"WEBORGUSER","Description":"Gives user the preparer access to MyTaxInfo, allowing them to create questionnaire, view status reports review/edit and send questionnaire to Gosystem"},{"Right":"MyTaxInfo Preparer (read only)","Code":"WEBORGUSERR","Description":"Gives user the prepare access to MyTaxInfo, allowing them to review and send the questionnaire"},{"Right":"Elf Admin","Code":"ELFADMIN","Description":"Allows user to access E-file section to submit and download e-files and generate e-file report"},{"Right":"Elf Unlock","Code":"ELFUNLOCK","Description":"Allows user to unlock e-files if any of the jurisdictions are locked"},{"Right":"Prior Year","Code":"PRIORYEAR","Description":"User will have access to prior year returns"},{"Right":"TEQ","Code":"TEQ","Description":""},{"Right":"Remove Completed Date","Code":"RMVCMPDATE","Description":"User will have access to remove completed date from return"},{"Right":"K1 Analyzer","Code":"K1ANALYZER","Description":"User will have access to K1 Analyzer"}]}}}}}},"404":{"description":"Not found"}}}},"/v1/groups":{"get":{"tags":["User Management"],"summary":"Get all group details","operationId":"Get All group details","description":"This endpoint retrieves all group details for the firm.","responses":{"200":{"description":"Success. All group details are retrieved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetGroupResponseWraper"},"examples":{"Success response":{"value":[{"Id":11,"GroupName":"FT_ADMIN","Center":"***","Firm":"FT","CanAddLocators":true,"CanDeleteLocators":true,"CanAssignLocators":true,"CanSetPasswords":true,"CanBypassBatchPrintPwd":false},{"Id":16,"GroupName":"RS DEVELOPMENT","Center":"DALLAS-D100","Firm":"FT","CanAddLocators":true,"CanDeleteLocators":true,"CanAssignLocators":true,"CanSetPasswords":true,"CanBypassBatchPrintPwd":false},{"Id":17,"GroupName":"RS TESTERS","Center":"DALLAS","Firm":"FT","CanAddLocators":true,"CanDeleteLocators":true,"CanAssignLocators":true,"CanSetPasswords":true,"CanBypassBatchPrintPwd":false}]}}}}},"404":{"description":"Not found"}}}},"/v1/users/{center}/{loginId}/groups":{"post":{"tags":["Groups Management"],"summary":"Assign or updat